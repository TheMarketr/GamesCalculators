---
import type { GameConfig } from '../data/games';
interface Props { game: GameConfig; featured?: boolean }
const { game, featured = false } = Astro.props;
---
<a href={`/${game.slug}/`} class:list={['game-card', `accent-${game.accent}`, { 'game-card--featured': featured }] }>
  <div class="game-card__top"><span class="game-glyph">{game.glyph}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
  <div><span class="eyebrow">{game.eyebrow}</span><h3>{game.shortName ?? game.name}</h3><p>{game.description}</p></div>
  <span class="card-meta">{game.tools.length ? `${game.tools.length} live ${game.tools.length === 1 ? 'tool' : 'tools'}` : 'Hub live · tools in development'}</span>
</a>
