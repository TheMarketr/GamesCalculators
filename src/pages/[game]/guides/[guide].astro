---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FAQSection from '../../../components/FAQSection.astro';
import ToolCard from '../../../components/ToolCard.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { getGame, type GameConfig } from '../../../data/games';
import { guides } from '../../../data/guides';
import { richGuideArticles, type RichGuideArticle } from '../../../data/rich-guides';

export function getStaticPaths() {
  return richGuideArticles.map((article) => ({ params: { game: article.gameSlug, guide: article.slug.split('/').at(-1)! }, props: { article, game: getGame(article.gameSlug)! } }));
}

interface Props { article: RichGuideArticle; game: GameConfig }
const { article, game } = Astro.props;
const relatedTools = game.tools.slice(0, 4);
const relatedGuides = guides.filter((guide) => guide.gameSlug === game.slug && guide.slug !== article.slug).slice(0, 3);
const canonical = `/${article.slug}/`;
const dateLabel = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date(`${article.updated}T12:00:00Z`));
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.description, datePublished: article.updated, dateModified: article.updated, mainEntityOfPage: `https://gamescalculators.com${canonical}`, author: { '@type': 'Organization', name: 'GamesCalculators' }, about: { '@type': 'VideoGame', name: game.name } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: article.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://gamescalculators.com/' },
    { '@type': 'ListItem', position: 2, name: game.name, item: `https://gamescalculators.com/${game.slug}/` },
    { '@type': 'ListItem', position: 3, name: article.title, item: `https://gamescalculators.com${canonical}` },
  ] },
];
---
<BaseLayout title={article.title} description={article.description} canonical={canonical} schema={schema}>
  <article class={`rich-guide accent-${game.accent}`}>
    <header class="rich-guide-hero">
      <div class="container-wide">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href={`/${game.slug}/`}>{game.shortName ?? game.name}</a><span>›</span><a href="/guides/">Guides</a><span>›</span><span aria-current="page">{article.category}</span></nav>
        <div class="rich-guide-hero-grid">
          <div>{game.icon && <img class="guide-game-icon" src={game.icon.src} alt={`${game.name} game icon`} width="92" height="92" loading="eager" decoding="async" />}<span class="eyebrow">{game.name} · {article.category}</span><h1>{article.title}</h1><p>{article.description}</p><div class="guide-byline"><span>GamesCalculators editorial team</span><time datetime={article.updated}>Updated {dateLabel}</time><span>{article.readingTime}</span></div></div>
          {game.image && <figure><img src={game.image.src} alt={game.image.alt} width="1200" height="675" loading="eager" decoding="async" /><figcaption><a href={game.image.creditUrl} target="_blank" rel="license noopener">{game.image.credit}</a> · <a href={game.image.licenseUrl} target="_blank" rel="license noopener">{game.image.license}</a></figcaption></figure>}
        </div>
      </div>
    </header>
    <div class="container-wide rich-guide-layout">
      <main class="rich-guide-main">
        <nav class="guide-jump-nav" aria-label="Guide sections"><a href="#overview">Overview</a><a href="#takeaways">Key points</a>{article.sections.map((section, index) => <a href={`#section-${index + 1}`}>{section.heading}</a>)}<a href="#checklist">Checklist</a><a href="#faq">FAQs</a></nav>
        <section id="overview" class="guide-intro-card">{article.lead.map((paragraph) => <p>{paragraph}</p>)}</section>
        <section id="takeaways" class="guide-takeaways"><span class="eyebrow">Key takeaways</span><h2>The useful version in one minute</h2><div>{article.takeaways.map((takeaway, index) => <article><strong>{String(index + 1).padStart(2, '0')}</strong><p>{takeaway}</p></article>)}</div></section>
        {article.sections.map((section, index) => <section id={`section-${index + 1}`} class="rich-guide-section"><span class="section-number">{String(index + 1).padStart(2, '0')}</span><div><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</div></section>)}
        <section id="checklist" class="guide-checklist"><div><span class="eyebrow">Practical workflow</span><h2>{article.game} checklist</h2><p>Work through the list in order, then revisit the assumptions that changed.</p></div><ol>{article.checklist.map((item, index) => <li><span>{index + 1}</span>{item}</li>)}</ol></section>
        {article.sources?.length && <section class="guide-sources"><span class="eyebrow">Sources and status</span><h2>Where the confirmed details come from</h2><p>Official sources take priority. Press coverage is used for clearly attributed observations from the presentation.</p><ul>{article.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener">{source.label}</a><span>{source.note}</span></li>)}</ul></section>}
        <div id="faq"><FAQSection faqs={article.faqs} gameName={game.shortName ?? game.name} /></div>
      </main>
      <aside class="rich-guide-sidebar"><div><span class="eyebrow">Independent guide</span><p>We label estimates and unknowns instead of turning them into facts. Game rules can change after updates.</p><a href="/editorial-policy/">Editorial policy →</a></div>{game.icon && <img src={game.icon.src} alt="" width="180" height="180" loading="lazy" decoding="async" />}<a class="button button--secondary" href={`/${game.slug}/`}>Open {game.shortName ?? game.name} hub</a></aside>
    </div>
    <section class="section section--surface"><div class="container-wide"><div class="section-heading section-heading--small"><div><span class="eyebrow">Put the guide to work</span><h2>Related calculators</h2></div><a href={`/${game.slug}/`}>All {game.shortName ?? game.name} tools →</a></div><div class="tool-grid">{relatedTools.map((tool) => <ToolCard name={tool.shortName} description={tool.description} href={`/${game.slug}/${tool.slug}/`} game={game.shortName ?? game.name} category={tool.category} accent={game.accent} />)}</div></div></section>
    {relatedGuides.length > 0 && <section class="section container-wide"><div class="section-heading section-heading--small"><div><span class="eyebrow">Continue learning</span><h2>More {game.shortName ?? game.name} guides</h2></div><a href="/guides/">All guides →</a></div><div class="guide-grid">{relatedGuides.map((guide) => <GuideCard guide={guide} accent={game.accent} />)}</div></section>}
  </article>
</BaseLayout>
