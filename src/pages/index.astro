---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalSearch from '../components/search/GlobalSearch';
import CalculatorCarousel from '../components/home/CalculatorCarousel';
import FAQSection from '../components/FAQSection.astro';
import GameCard from '../components/GameCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { featuredTools, games, publishedTools } from '../data/games';
import type { SearchEntry } from '../components/search/GlobalSearch';
import { guides } from '../data/guides';

const searchEntries: SearchEntry[] = [
  ...games.map((game) => ({ title: `${game.name} Calculators & Tools`, game: game.name, description: game.description, href: `/${game.slug}/`, keywords: [game.shortName ?? '', game.eyebrow], type: 'Game' as const })),
  ...publishedTools.map((tool) => ({ title: tool.name, game: tool.game.name, description: tool.description, href: `/${tool.game.slug}/${tool.slug}/`, keywords: tool.keywords ?? [], type: 'Tool' as const })),
  ...guides.map((guide) => ({ title: guide.title, game: guide.game, description: guide.description, href: `/${guide.slug}/`, keywords: [...guide.keywords], type: 'Guide' as const })),
];
const trendSlugs = ['minecraft', 'pokemon-go', 'osrs', 'palworld', 'blox-fruits', 'fortnite', 'gta-6'];
const trending = trendSlugs.map((slug) => games.find((game) => game.slug === slug)!);
const newFeatureKeys = [
  'pokemon-go/cp-calculator',
  'osrs/dps-calculator',
  'osrs/drop-rate-calculator',
  'palworld/breeding-calculator',
  'palworld/iv-calculator',
];
const newFeaturedTools = newFeatureKeys.map((key) => publishedTools.find((tool) => `${tool.game.slug}/${tool.slug}` === key)!);
const illustratedGames = games.filter((game) => game.image);
const gta = games.find((game) => game.slug === 'gta-6')!;
const gtaExtendedGuide = guides.find((guide) => guide.slug === 'gta-6/guides/extended-look-breakdown')!;
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
const recentReviewedTools = publishedTools
  .map((tool) => ({ ...tool, reviewed: tool.lastReviewed }))
  .sort((a, b) => b.reviewed.localeCompare(a.reviewed));
const homeFaqs = [
  { question: 'What is GamesCalculators?', answer: 'GamesCalculators is an independent library of free browser-based game calculators, planning tools, searchable references and player guides. It is built to help players turn game values, coordinates, progress, odds and trade offers into decisions they can review.' },
  { question: 'Are these game calculators official?', answer: 'No. GamesCalculators is an independent fan utility and is not affiliated with, sponsored by or endorsed by Minecraft, Roblox, Epic Games, Rockstar Games or other publishers. Game names identify compatibility only.' },
  { question: 'How are calculator results checked?', answer: 'Formula logic is kept separate from the interface and covered by automated tests where practical. Data-driven tools show an update date, explain their assumptions and link to the site data methodology.' },
  { question: 'Are trade values guaranteed?', answer: 'No. Community trade values and demand can change quickly. Value and WFL calculators organize reference data and expose the value gap, but another player, an update or a market trend can produce a different outcome.' },
  { question: 'Do I need an account or subscription?', answer: 'No. The calculators are free to use without registration. Tools that remember a checklist or collection store it locally in the current browser rather than creating a GamesCalculators account.' },
  { question: 'Does GamesCalculators collect my game login?', answer: 'No. The site does not ask for game credentials, account passwords or authentication codes. Never enter those details into a third-party calculator.' },
  { question: 'How often is game data updated?', answer: 'Each data-driven calculator displays its latest review date. We prioritize reviews after important patches, new items, economy shifts or confirmed publisher announcements, but players should still verify high-stakes decisions in game.' },
  { question: 'Can a calculator guarantee a win, drop or exact FPS?', answer: 'No. Random outcomes, live markets, player behavior and hardware conditions cannot be guaranteed. The tools use transparent estimates, probability or performance ranges so the limits remain visible.' },
  { question: 'How can I report an outdated value or calculation?', answer: 'Use the contact page and include the game, tool URL, value you believe changed and a reliable source. Clear reports are easier to verify and update.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: homeFaqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<BaseLayout title="Free Game Calculators & Online Tools for Your Favorite Games" description="Free calculators and planning tools for Pokémon GO, OSRS, Palworld, Minecraft, Roblox games, Fortnite, GTA VI and more." schema={faqSchema}>
  <section class="hero-section"><div class="hero-orb hero-orb--one"></div><div class="hero-orb hero-orb--two"></div>
    <div class="container hero-grid">
      <div class="hero-copy"><div class="status-pill"><span></span> Free browser tools for players</div><h1>Free game calculators<br /><em>& online tools.</em></h1><p>Useful calculators, planners and interactive references for your favorite games—built to explain the answer as clearly as the result.</p><GlobalSearch entries={searchEntries} client:load /><div class="hero-suggestions"><span>Popular:</span><a href="/pokemon-go/cp-calculator/">Pokémon GO CP</a><a href="/osrs/dps-calculator/">OSRS DPS</a><a href="/palworld/breeding-calculator/">Palworld Breeding</a></div></div>
      <CalculatorCarousel client:load />
    </div><div class="trust-strip container"><span><b>✓</b> Working tools</span><span><b>◎</b> Mobile friendly</span><span><b>◇</b> No sign-up</span><span><b>↻</b> Dated data reviews</span></div>
  </section>

  <section class="section container-wide"><a class="home-news-feature accent-sunset" href={`/${gtaExtendedGuide.slug}/`}><div><span class="status-pill"><span></span> Research updated August 31</span><span class="eyebrow">GTA VI · An Extended Look</span><h2>What Rockstar showed—and what is still unconfirmed</h2><p>Our source-graded breakdown covers Jason and Lucia, character switching, body and relationship systems, wanted-state feedback, activities, editions and the questions Rockstar has not answered.</p><div><span>16 min guide</span><span>Official sources</span><span>77 sourced records</span></div><strong>Read the Extended Look breakdown →</strong></div>{gta.image && <img src={gta.image.src} alt={gta.image.alt} width="1200" height="675" loading="eager" decoding="async" />}</a></section>

  <section class="section container-wide" aria-labelledby="trending-heading"><div class="section-heading"><div><span class="eyebrow">Choose a game</span><h2 id="trending-heading">Popular game hubs</h2><p>Open a complete collection of calculators, references and gameplay guides.</p></div><a href="/games/">View all games <span>→</span></a></div><div class="trending-row">{trending.map((game) => <a href={`/${game.slug}/`} class={`trend-chip accent-${game.accent}`}>{game.icon ? <img class="trend-game-icon" src={game.icon.src} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span class="game-glyph">{game.glyph}</span>}<strong>{game.shortName ?? game.name}</strong><span>→</span></a>)}</div></section>

  <section class="section section--surface" id="popular-tools" aria-labelledby="popular-heading"><div class="container-wide"><div class="section-heading"><div><span class="eyebrow">Solve a gameplay problem</span><h2 id="popular-heading">Popular working calculators</h2><p>Estimate a value, compare a trade, plan progress, convert coordinates or test performance assumptions.</p></div><a href="/tools/">Browse all tools <span>→</span></a></div><div class="tool-grid">{featuredTools.slice(0, 6).map((tool) => <ToolCard name={tool.shortName} description={tool.description} href={`/${tool.game.slug}/${tool.slug}/`} game={tool.game.shortName ?? tool.game.name} category={tool.category} accent={tool.game.accent} />)}</div></div></section>

  <section class="section container-wide" aria-labelledby="new-clusters-heading"><div class="section-heading"><div><span class="eyebrow">New complete collections</span><h2 id="new-clusters-heading">Pokémon GO, OSRS and Palworld tools</h2><p>Start with five of the strongest stat, combat, probability and breeding calculators from the new game hubs.</p></div><a href="/games/">Explore the game hubs <span>→</span></a></div><div class="tool-grid">{newFeaturedTools.map((tool) => <ToolCard name={tool.shortName} description={tool.description} href={`/${tool.game.slug}/${tool.slug}/`} game={tool.game.shortName ?? tool.game.name} category={tool.category} accent={tool.game.accent} />)}</div></section>

  <section class="section container-wide" aria-labelledby="problems-heading"><div class="section-heading"><div><span class="eyebrow">What we help players do</span><h2 id="problems-heading">From uncertain inputs to a checkable plan</h2><p>Every tool starts with a specific gameplay question and shows the assumptions behind the answer.</p></div></div><div class="problem-grid"><article><span>01</span><h3>Plan builds and resources</h3><p>Convert dimensions, ingredients, levels, fuel, food and other requirements into a practical checklist before you spend time or materials.</p><a href="/tools/#planning">Explore planning tools →</a></article><article><span>02</span><h3>Compare values and trades</h3><p>Total both sides of an offer, review item demand and understand why a numerical fair range is only one part of a player-to-player trade.</p><a href="/tools/#values-trading">Explore value tools →</a></article><article><span>03</span><h3>Estimate progress and odds</h3><p>Turn XP goals, deadlines and per-attempt chances into remaining work or probability without presenting an estimate as a guarantee.</p><a href="/tools/#progress-odds">Explore progress tools →</a></article><article><span>04</span><h3>Check settings and performance</h3><p>Compare sensitivity, hardware, resolution and combat timing with consistent inputs before changing a setup you already understand.</p><a href="/tools/#performance">Explore performance tools →</a></article></div></section>

  <section class="section game-context-section" aria-labelledby="game-context-heading"><div class="container-wide"><div class="section-heading"><div><span class="eyebrow">Gameplay in context</span><h2 id="game-context-heading">Tools connected to the games they support</h2><p>Licensed imagery adds context without pretending that GamesCalculators is an official publisher site.</p></div></div><div class="game-image-grid">{illustratedGames.map((game) => <figure class={`game-image-card accent-${game.accent}`}><img src={game.image!.src} alt={game.image!.alt} width="1200" height="675" loading="lazy" decoding="async" /><div><span class="eyebrow">{game.eyebrow}</span><h3>{game.name}</h3><p>{game.description}</p><a class="button button--secondary" href={`/${game.slug}/`}>Open {game.shortName ?? game.name} hub</a></div><figcaption><a href={game.slug === 'gta-6' ? '/media-credits/' : game.image!.creditUrl} target={game.slug === 'gta-6' ? undefined : '_blank'} rel={game.slug === 'gta-6' ? undefined : 'license noopener'}>{game.image!.credit}</a> · <a href={game.slug === 'gta-6' ? '/media-credits/' : game.image!.licenseUrl} target={game.slug === 'gta-6' ? undefined : '_blank'} rel={game.slug === 'gta-6' ? undefined : 'license noopener'}>{game.image!.license}</a></figcaption></figure>)}</div></div></section>

  <section class="section container-wide" id="games" aria-labelledby="games-heading"><div class="section-heading"><div><span class="eyebrow">{games.length} complete collections</span><h2 id="games-heading">Browse all supported games</h2><p>Each game hub groups its working calculators, searchable references and related player guides.</p></div><a href="/games/">Open games directory <span>→</span></a></div><div class="game-grid">{games.map((game) => <GameCard game={game} />)}</div></section>

  <section class="section section--surface" aria-labelledby="trust-heading"><div class="container-wide legitimacy-grid"><div><span class="eyebrow">Independent and transparent</span><h2 id="trust-heading">Why players can evaluate our answers</h2><p>Trust should come from visible assumptions and corrections—not a badge we give ourselves. Calculator formulas are separated from the interface, data pages show review dates, and uncertain inputs are labeled as estimates or samples.</p><div class="legitimacy-links"><a href="/data-methodology/">Data methodology</a><a href="/editorial-policy/">Editorial policy</a><a href="/disclaimer/">Independence disclaimer</a><a href="/contact/">Report an issue</a></div></div><div class="legitimacy-checks"><article><strong>{publishedTools.length}</strong><span>working calculators and tools</span></article><article><strong>{games.length}</strong><span>game hubs with focused resources</span></article><article><strong>{guides.length}</strong><span>supporting gameplay guides</span></article><article><strong>0</strong><span>game passwords requested</span></article></div></div></section>

  <section class="section container-wide update-about-grid"><div class="updates-panel"><div class="section-heading section-heading--small"><div><span class="eyebrow">Maintenance log</span><h2>Recently reviewed tools</h2></div><a href="/data-methodology/">How updates work →</a></div><div class="update-list">{recentReviewedTools.slice(0, 5).map((tool) => <a href={`/${tool.game.slug}/${tool.slug}/`}><span class={`update-icon accent-${tool.game.accent}`}>{tool.game.glyph}</span><span><strong>{tool.shortName}</strong><small>{tool.game.shortName ?? tool.game.name}</small></span><time datetime={tool.reviewed}>Reviewed {dateFormatter.format(new Date(`${tool.reviewed}T12:00:00Z`))}</time></a>)}</div></div><aside class="about-card"><span class="eyebrow">Build a better answer</span><h2>Calculator first, explanation included.</h2><p>The interactive result stays easy to reach, with detailed gameplay context, step-by-step instructions, limitations and intent-focused FAQs below it.</p><a href="/guides/" class="button button--secondary">Browse player guides</a></aside></section>

  <section class="section section--surface"><div class="container"><FAQSection faqs={homeFaqs} /></div></section>
</BaseLayout>
