---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalSearch from '../components/search/GlobalSearch';
import GameCard from '../components/GameCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { featuredTools, games, publishedTools, recentTools } from '../data/games';
import type { SearchEntry } from '../components/search/GlobalSearch';
import { guides } from '../data/guides';
const searchEntries: SearchEntry[] = [
  ...games.map((game) => ({ title: `${game.name} Calculators & Tools`, game: game.name, description: game.description, href: `/${game.slug}/`, keywords: [game.shortName ?? '', game.eyebrow], type: 'Game' as const })),
  ...publishedTools.map((tool) => ({ title: tool.name, game: tool.game.name, description: tool.description, href: `/${tool.game.slug}/${tool.slug}/`, keywords: tool.keywords ?? [], type: 'Tool' as const })),
  ...guides.map((guide) => ({ title: guide.title, game: guide.game, description: guide.description, href: `/${guide.slug}/`, keywords: [...guide.keywords], type: 'Guide' as const })),
];
const trendSlugs = ['minecraft', 'blox-fruits', 'grow-a-garden', 'adopt-me', 'fortnite', 'steal-a-brainrot', 'gta-6'];
const trending = trendSlugs.map((slug) => games.find((game) => game.slug === slug)!);
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
---
<BaseLayout title="Game Calculators, Tools & Interactive Guides" description="Get quick answers with free gaming calculators for Minecraft, Blox Fruits, Grow a Garden, Adopt Me, Fortnite and more.">
  <section class="hero-section"><div class="hero-orb hero-orb--one"></div><div class="hero-orb hero-orb--two"></div>
    <div class="container hero-grid">
      <div class="hero-copy"><div class="status-pill"><span></span> Built for quick answers</div><h1>Game calculators.<br /><em>Instant answers.</em></h1><p>Accurate, easy-to-use tools for the games you play—without the popups, clutter or guesswork.</p><GlobalSearch entries={searchEntries} client:load /><div class="hero-suggestions"><span>Popular:</span><a href="/minecraft/circle-generator/">Circle Generator</a><a href="/blox-fruits/trade-calculator/">Trade Calculator</a><a href="/fortnite/fps-calculator/">FPS</a></div></div>
      <div class="hero-dashboard" aria-label="Popular calculator preview"><div class="dashboard-top"><span><i></i><i></i><i></i></span><small>gamescalculators.com/tool</small><b>⌁</b></div><div class="dashboard-body"><div class="dashboard-title"><span class="mini-icon">MC</span><div><small>POPULAR TOOL</small><strong>Minecraft Circle Generator</strong></div><span class="live-badge">LIVE</span></div><div class="fake-controls"><label>Diameter <strong>21</strong></label><div class="fake-slider"><i></i></div><div class="toggle-row"><span class="active">Outline</span><span>Filled</span></div></div><div class="pixel-preview" aria-hidden="true">{Array.from({ length: 81 }).map((_, index) => <i class:list={{ on: [4,12,13,20,21,22,28,29,35,36,44,45,51,52,58,59,60,67,68,76].includes(index) }}></i>)}</div><div class="dashboard-result"><span><small>Blocks needed</small><strong>56</strong></span><a href="/minecraft/circle-generator/">Open generator <b>↗</b></a></div></div></div>
    </div><div class="trust-strip container"><span><b>⚡</b> Instant results</span><span><b>◎</b> Mobile friendly</span><span><b>◇</b> No sign-up</span><span><b>✓</b> Free to use</span></div>
  </section>
  <section class="section container-wide" aria-labelledby="trending-heading"><div class="section-heading"><div><span class="eyebrow">Jump back in</span><h2 id="trending-heading">Trending games</h2></div><a href="#games">View all games <span>→</span></a></div><div class="trending-row">{trending.map((game) => <a href={`/${game.slug}/`} class={`trend-chip accent-${game.accent}`}><span class="game-glyph">{game.glyph}</span><strong>{game.shortName ?? game.name}</strong><span>→</span></a>)}</div></section>
  <section class="section section--surface" id="popular-tools" aria-labelledby="popular-heading"><div class="container-wide"><div class="section-heading"><div><span class="eyebrow">Player favorites</span><h2 id="popular-heading">Popular tools</h2><p>Start with the utilities players use most.</p></div><a href="#games">Browse by game <span>→</span></a></div><div class="tool-grid">{featuredTools.slice(0, 6).map((tool) => <ToolCard name={tool.shortName} description={tool.description} href={`/${tool.game.slug}/${tool.slug}/`} game={tool.game.shortName ?? tool.game.name} category={tool.category} accent={tool.game.accent} />)}</div></div></section>
  <section class="section container-wide" id="games" aria-labelledby="games-heading"><div class="section-heading"><div><span class="eyebrow">Ten growing collections</span><h2 id="games-heading">All games</h2><p>Pick a game to see its calculators, generators and interactive guides.</p></div></div><div class="game-grid">{games.map((game) => <GameCard game={game} />)}</div></section>
  <section class="section container-wide update-about-grid"><div class="updates-panel"><div class="section-heading section-heading--small"><div><span class="eyebrow">Fresh data</span><h2>Recently updated</h2></div><a href="/data-methodology/">How updates work →</a></div><div class="update-list">{recentTools.slice(0, 5).map((tool) => <a href={`/${tool.game.slug}/${tool.slug}/`}><span class={`update-icon accent-${tool.game.accent}`}>{tool.game.glyph}</span><span><strong>{tool.shortName}</strong><small>{tool.game.shortName ?? tool.game.name}</small></span><time datetime={tool.updated}>Updated {dateFormatter.format(new Date(`${tool.updated}T12:00:00Z`))}</time></a>)}</div></div><aside class="about-card"><span class="eyebrow">Why GamesCalculators?</span><h2>Tools first. Answers fast.</h2><p>Every page starts with something useful you can interact with. Formula logic stays separate from the interface, and changing game values live in simple data files.</p><div class="about-stats"><span><strong>{games.length}</strong> game hubs</span><span><strong>{publishedTools.length}</strong> live tools</span><span><strong>0</strong> accounts needed</span></div><a href="/data-methodology/" class="button button--secondary">Our data methodology</a></aside></section>
</BaseLayout>
