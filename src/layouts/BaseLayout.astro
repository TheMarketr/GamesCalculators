---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PrivacyDialog from '../components/PrivacyDialog.astro';
import { games, publishedTools } from '../data/games';
import { site } from '../config/site';
import { guides } from '../data/guides';
import type { SearchEntry } from '../components/search/GlobalSearch';

interface Props {
  title?: string; description?: string; canonical?: string; image?: string; noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title = site.title, description = site.description, canonical = Astro.url.pathname, image, noindex = false, schema } = Astro.props;
const pageTitle = title.includes('GamesCalculators') ? title : `${title} | GamesCalculators`;
const trimMetaDescription = (value: string, maximum = 150) => {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maximum) return normalized;
  const candidate = normalized.slice(0, maximum - 1);
  const lastSpace = candidate.lastIndexOf(' ');
  const cutoff = lastSpace >= maximum - 24 ? lastSpace : maximum - 1;
  return `${candidate.slice(0, cutoff).replace(/[\s,;:–—-]+$/g, '').replace(/[.!?]+$/g, '')}.`;
};
const buildMetaDescription = (value: string, pageName: string) => {
  let result = value.replace(/\s+/g, ' ').trim();
  if (result.length < 135) {
    const suffix = /guide/i.test(pageName)
      ? 'Read practical steps, examples, limitations and related calculator advice for players.'
      : /(privacy|cookies|terms|disclaimer|policy|methodology|dmca|contact|credits)/i.test(pageName)
        ? 'Read how this information applies to visitors, local data and browser-based game tools.'
        : /calculators\s*&\s*tools/i.test(pageName)
          ? 'Explore working tools, reviewed data and game-specific guides for clearer decisions.'
          : 'Use this free browser tool for clear inputs, transparent results and practical game planning.';
    result = `${result.replace(/[.!?]+$/g, '')}. ${suffix}`;
  }
  if (result.length < 135) result = `${result.replace(/[.!?]+$/g, '')}. Built for players.`;
  return trimMetaDescription(result);
};
const metaDescription = buildMetaDescription(description, title);
const canonicalUrl = new URL(canonical, site.url).toString();
const ogKey = canonical === '/' ? 'home' : canonical.replace(/^\/+|\/+$/g, '').replaceAll('/', '--');
const imageUrl = new URL(image ?? `/og/${ogKey}.png`, site.url).toString();
const searchEntries: SearchEntry[] = [
  ...games.map((game) => ({ title: `${game.name} Calculators & Tools`, game: game.name, description: game.description, href: `/${game.slug}/`, keywords: [game.shortName ?? '', game.eyebrow], type: 'Game' as const })),
  ...publishedTools.map((tool) => ({ title: tool.name, game: tool.game.name, description: tool.description, href: `/${tool.game.slug}/${tool.slug}/`, keywords: tool.keywords ?? [], type: 'Tool' as const })),
  ...guides.map((guide) => ({ title: guide.title, game: guide.game, description: guide.description, href: `/${guide.slug}/`, keywords: [...guide.keywords], type: 'Guide' as const })),
];
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.description, potentialAction: { '@type': 'SearchAction', target: `${site.url}/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="generator" content={Astro.generator} /><meta name="theme-color" content="#090e1a" />
    <meta name="description" content={metaDescription} /><meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} /><link rel="canonical" href={canonicalUrl} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" /><meta property="og:site_name" content={site.name} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={metaDescription} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={imageUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} /><meta name="twitter:description" content={metaDescription} /><meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VHF1PPEP5H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VHF1PPEP5H');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />{schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader searchEntries={searchEntries} /><main id="main-content"><slot /></main><SiteFooter /><PrivacyDialog /></body>
</html>
