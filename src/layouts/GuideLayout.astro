---
import BaseLayout from './BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import FAQSection from '../components/FAQSection.astro';
import GuideDepthSection from '../components/GuideDepthSection.astro';
import MediaGallery from '../components/MediaGallery.astro';
import { getGame } from '../data/games';
import { guides } from '../data/guides';
interface Props { frontmatter: { title: string; description: string; game: string; gameSlug: string; updated: string; category?: string } }
const { frontmatter } = Astro.props;
const game = getGame(frontmatter.gameSlug);
const relatedTools = game?.tools.slice(0, 4) ?? [];
const relatedGuides = guides.filter((guide) => guide.gameSlug === frontmatter.gameSlug && guide.title !== frontmatter.title).slice(0, 3);
const faqs = [
  { question: `Who is this ${frontmatter.title} for?`, answer: `It is for ${frontmatter.game} players who want a repeatable workflow, clearer assumptions and direct links to the relevant calculators rather than an unexplained recommendation.` },
  { question: `Is this ${frontmatter.game} guide official?`, answer: `No. GamesCalculators is an independent fan utility. Publisher information is prioritized where available, while community values and planning estimates are labeled as changeable.` },
  { question: 'How should I use the calculator with this guide?', answer: 'Read the mechanic first, enter values from your current game state, inspect the breakdown and test at least one alternate scenario before acting on the result.' },
  { question: 'Can game updates make this information outdated?', answer: `Yes. ${frontmatter.game} rules, items and community markets can change. The visible review date tells you when this guide was last checked.` },
  { question: 'What should I do if my result is different in game?', answer: 'Recheck units, variants, active boosts and duplicated effects. If the difference remains reproducible, report the page and exact inputs through the contact link.' },
];
const schema=[{'@context':'https://schema.org','@type':'Article',headline:frontmatter.title,description:frontmatter.description,dateModified:frontmatter.updated,author:{'@type':'Organization',name:'GamesCalculators'}},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map((faq)=>({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.answer}}))}];
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} schema={schema}>
  <article class:list={['guide-page', game && `accent-${game.accent}`]}><header class="guide-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Home</a><span>›</span><a href={`/${frontmatter.gameSlug}/`}>{frontmatter.game}</a><span>›</span><span>Guide</span></nav><div class="legacy-guide-lockup">{game?.icon && <img class="guide-game-icon" src={game.icon.src} alt={`${frontmatter.game} game icon`} width="92" height="92" loading="eager" decoding="async" />}<div><span class="eyebrow">{frontmatter.game} guide</span><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p><time datetime={frontmatter.updated}>Updated {frontmatter.updated}</time></div></div></div></header><div class="container guide-body"><div><nav class="guide-jump-nav" aria-label="Guide navigation"><a href="#guide-article">Main guide</a><a href="#guide-depth-heading">Deep dive</a><a href="#guide-workflow">How to apply it</a><a href="#related-calculators">Calculators</a><a href="#faq">FAQs</a></nav>{game?.image && <figure class="legacy-guide-media"><img src={game.image.src} alt={game.image.alt} width="1200" height="675" loading="eager" decoding="async" /><figcaption><a href={game.image.creditUrl} target="_blank" rel="license noopener">{game.image.credit}</a> · <a href={game.image.licenseUrl} target="_blank" rel="license noopener">{game.image.license}</a></figcaption></figure>}{game?.slug === 'gta-6' && game.gallery && <MediaGallery items={game.gallery} galleryId={`legacy-guide-${frontmatter.title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`} title="Explore GTA VI in official screenshots" description="Open the characters and Leonida locations in a full-size viewer while reading the guide." limit={6} compact />}<div class="prose" id="guide-article"><slot /></div><GuideDepthSection game={frontmatter.game} gameSlug={frontmatter.gameSlug} title={frontmatter.title} category={frontmatter.category} /><section class="legacy-guide-workflow" id="guide-workflow"><span class="eyebrow">From reading to a decision</span><h2>Apply this {frontmatter.game} guide in four passes</h2><ol><li><strong>Record the current state.</strong><span>Use the exact item, level, variant, resource count or platform information visible in your game.</span></li><li><strong>Calculate a baseline.</strong><span>Enter only verified inputs first so the initial result remains easy to audit.</span></li><li><strong>Test uncertainty.</strong><span>Change one assumption at a time and compare a conservative case with the expected result.</span></li><li><strong>Verify before committing.</strong><span>Recheck the live game screen, official announcement or final trade window before spending resources.</span></li></ol></section></div><aside><span class="eyebrow">Independent guide</span><p>Game rules and values can change. We review guides after significant patches and show the latest update date.</p><a href="/data-methodology/">Data methodology →</a>{game?.icon && <img src={game.icon.src} alt="" width="150" height="150" loading="lazy" decoding="async" />}</aside></div>
    {game && relatedTools.length > 0 && <section class="section section--surface" id="related-calculators"><div class="container-wide"><div class="section-heading section-heading--small"><div><span class="eyebrow">Use the numbers</span><h2>Related {game.shortName ?? game.name} calculators</h2><p>Open a working tool, enter your current situation and use this guide to interpret the breakdown.</p></div><a href={`/${game.slug}/`}>All tools →</a></div><div class="tool-grid">{relatedTools.map((tool) => <ToolCard name={tool.shortName} description={tool.description} href={`/${game.slug}/${tool.slug}/`} game={game.shortName ?? game.name} category={tool.category} accent={game.accent} />)}</div></div></section>}
    <section class="section container" id="faq"><FAQSection faqs={faqs} gameName={game?.shortName ?? frontmatter.game} /></section>
    {game && relatedGuides.length > 0 && <section class="section section--surface"><div class="container"><div class="section-heading section-heading--small"><div><span class="eyebrow">Keep learning</span><h2>More {game.shortName ?? game.name} guides</h2></div><a href="/guides/">All guides →</a></div><div class="legacy-guide-links">{relatedGuides.map((guide) => <a href={`/${guide.slug}/`}><strong>{guide.title}</strong><span>{guide.description}</span></a>)}</div></div></section>}
  </article>
</BaseLayout>
