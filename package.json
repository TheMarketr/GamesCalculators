    "preact": "^10.29.8"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
